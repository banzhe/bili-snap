{
  "name": "bili-snap",
  "version": "0.0.1",
  "private": true,
  "description": "在 bilibili 视频页按快捷键截取不含弹幕的视频帧，保存到指定目录。",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "husky",
    "release:patch": "pnpm version patch -m \"chore(release): v%s\" && git push --follow-tags",
    "release:minor": "pnpm version minor -m \"chore(release): v%s\" && git push --follow-tags",
    "release:major": "pnpm version major -m \"chore(release): v%s\" && git push --follow-tags"
  },
  "dependencies": {
    "@kobalte/core": "^0.13.14",
    "@solidjs/router": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-solid": "^1.55.0",
    "solid-js": "^1.9.11",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@wxt-dev/module-solid": "^1.1.4",
    "husky": "^9.1.7",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  },
  "packageManager": "pnpm@12.11.2"
}
